<Window x:Class="_3dconst_launch.Views.Welcome_New"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_3dconst_launch.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Title="E1" 
        Height="390" 
        Width="550" 
        Icon="/images/logoBorder.png"
        Style="{StaticResource MaterialDesignWindow}" Cursor="">
    <Border CornerRadius="10" BorderThickness="2" Background="#111111" >
        
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Margin="20,5,20,0"
                    Padding="5,5,5,15"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    BorderThickness="0,0,0,1"
                    BorderBrush="White">
                <Grid Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/images/logo_new.png"
                           Height="28"
                           Width="90"
                           HorizontalAlignment="Left"
                           Cursor="Arrow"
                           Grid.Column="0"/>

                    <Button Height="25"
                            Background="#2617BC43"
                            Grid.Column="1" Cursor="Hand"
                            Width="auto"
                            BorderThickness="0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            ToolTip="MaterialDesignRaisedDarkButton with Round Corners">
                        <TextBlock Text="Администратор"
                                   FontSize="14"
                                   Foreground="#1DF857"
                                   FontFamily="Manrope"/>
                    </Button>

                    <Button Style="{StaticResource ButtonMin}" 
                            Content="{materialDesign:PackIcon Kind=WindowMinimize}"
                            BorderThickness="0"
                            DataContext="0"
                            Width="20"
                            Height="10"
                            Template="{StaticResource CornerButton}"
                            Grid.Column="2" Cursor="Hand">
                    </Button>

                    <Button Style="{StaticResource ButtonMin}" 
                            BorderThickness="0"
                            Content="{materialDesign:PackIcon Kind=Close}"
                            DataContext="0"
                            Template="{StaticResource CornerButton}"
                            Grid.Column="3" Cursor="Hand">
                    </Button>

                </Grid>
                

            </Border>

            <Border BorderThickness="0,0,0,0.5"
                    BorderBrush="#414141"
                    Grid.Row="1"
                    Margin="20,5,20,0" Cursor="">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HumanGreeting" 
                         Foreground="White"
                         Height="20" Width="30"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Padding="0, 0,0,0"/>
                        <TextBlock Text="Добро пожаловать!" 
                               Foreground="White"
                               FontSize="24" FontFamily="Manrope"/>

                    </StackPanel>

                    <TextBlock Foreground="#D1D1D1"
                               Margin="9,6,0,0"
                               FontSize="18"
                               Text="Выберите режим в котором хотите продолжить работу "/>
                </StackPanel>



            </Border>

            <Border BorderThickness="0" 
                    Margin="25,10,20,0" 
                    Grid.Row="2">
                <StackPanel>
                    <TextBlock Text="Режим работы"
                               Foreground="#D1D1D1"
                              FontSize="16"
                               FontFamily="Manrope"/>


                    <ComboBox x:Name="OutlinedComboBox"
                              Width="auto"
                              Margin="0,7,0,0"
                              FontSize="16"
                              materialDesign:HintAssist.Hint="Some item"
                              IsEnabled="{Binding Path=IsChecked, ElementName=OutlinedComboBoxEnabledCheckBox}"
                              ItemsSource="{Binding ShortStringList}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                              Background="#1A1A1A"
                              Foreground="White"
                              BorderThickness="0"
                              FontFamily="Manrope"/>
                </StackPanel>
                
            </Border>
            <Button Width="auto"
                    Margin="20,0,20,5"
                    Content="Применить"
                    VerticalAlignment="Bottom"
                    Background="#17BC43"
                    FontFamily="Manrope"
                    FontSize="16"
                    Foreground="White"
                    BorderThickness="0"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                    ToolTip="Resource name: MaterialDesignRaisedSecondaryDarkButton" 
                    Grid.Row="2" Cursor="Hand"/>
        </Grid>
        
    </Border>
</Window>
