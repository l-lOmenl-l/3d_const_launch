<Window x:Class="_3dconst_launch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_3dconst_launch"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Title="E1" 
        Height="500" 
        Width="550" 
        Icon="/images/logoBorder.png"
        MouseDown="Window_MouseDown"
        Style="{StaticResource MaterialDesignWindow}" Cursor="">
    <Border CornerRadius="10" BorderThickness="2" Background="#111111" >
        <Grid x:Name="MainGrid" IsEnabled="True" >


            <Grid x:Name="SecondGrid">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Margin="20,18,20,0"
                    Padding="5,5,5,15"
                    Height="50"
                    VerticalAlignment="Top"
                    BorderThickness="0,0,0,1"
                    BorderBrush="White">
                    <Grid Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/images/logo_new.png"
                           Height="28"
                           Width="90"
                           HorizontalAlignment="Left"
                           Cursor="Arrow"
                           Grid.Column="0"/>

                        <Button x:Name="btnSettings"
                                Height="25"
                                Background="#2617BC43"
                                Grid.Column="1" Cursor="Hand"
                                Width="130"
                                Click="btnSettings_Click"
                                BorderThickness="0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline"
                                                         Margin="0,0,10,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Foreground="#17BC43"/>
                                <TextBlock Text="Настройки"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Foreground="#1DF857"
                                           FontFamily="Manrope"/>
                            </StackPanel>

                        </Button>

                        <Button x:Name="btnMinimize"
                                Click="btnMinimize_Click"
                                Style="{StaticResource ButtonMin}" 
                                Content="{materialDesign:PackIcon Kind=WindowMinimize}"
                                BorderThickness="0"
                                DataContext="0"
                                Width="20"
                                Height="10"
                                Template="{StaticResource CornerButton}"
                                Grid.Column="2" Cursor="Hand">
                        </Button>

                        <Button x:Name="btnClose"
                                Click="btnClose_Click"
                                Style="{StaticResource ButtonMin}" 
                                BorderThickness="0"
                                Content="{materialDesign:PackIcon Kind=Close}"
                                DataContext="0"
                                Template="{StaticResource CornerButton}"
                                Grid.Column="3" Cursor="Hand">
                        </Button>

                    </Grid>


                </Border>

                <Border BorderThickness="0,0,0,0"
                    BorderBrush="#414141"
                    Grid.Row="1"
                    Margin="20,5,20,0" Cursor="">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconTitle"
                                                     Kind="CheckCircleOutline" 
                                                     Margin="0,0,10,0"
                                                     Foreground="White"
                                                     Height="30" Width="30"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Padding="0, 0,0,0"/>
                            <TextBlock x:Name="Title"
                                       Text="Можно запускать" 
                                   Foreground="White"
                                   FontSize="24" FontFamily="Manrope"/>

                        </StackPanel>

                        <TextBlock x:Name="Desctiption"
                                   LineHeight="25"
                                   Foreground="#D1D1D1"
                                   Margin="9,10,0,0"
                                   FontSize="18"
                                   TextWrapping="Wrap"
                                   Text="Какое то нужно придумать сюда описание без него будет не очень наполнено смотреться окно"/>
                    </StackPanel>



                </Border>

                <StackPanel VerticalAlignment="Bottom"
                            Grid.Row="2" 
                            Margin="20,0,20,15">
                    
                    <StackPanel x:Name="SP_Warning"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,0">

                        <materialDesign:PackIcon x:Name="icon_Warning"
                                                 Kind="Alert"
                                                 Margin="0,0,5,0"
                                                 Height="30"
                                                 Width="30"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Foreground="Yellow"/>

                        <TextBlock x:Name="label_Warning" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Manrope"
                                   FontSize="16"
                                   Text="Тестовый режим"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">

                        <materialDesign:PackIcon x:Name="icon_labelMessage"
                                                 Kind="Check"
                                                 Margin="0,0,5,0"
                                                 Height="30"
                                                 Width="30"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Foreground="White"/>
                        
                        <TextBlock x:Name="label_message" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontFamily="Manrope"
                                   FontSize="16"
                                   Text="Файлы успешно прошли проверку"/>
                    </StackPanel>


                    <Button x:Name="Btn_launch" 
                            Width="auto"
                            Height="60"
                            Click="Btn_launch_Click"
                            Background="#17BC43"
                            BorderThickness="0"
                            materialDesign:ButtonAssist.CornerRadius="7"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}"
                            Grid.Row="2" Cursor="">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                            <TextBlock x:Name="Btn_download"
                                        Text="Запустить"                         
                                           FontFamily="Manrope"
                                           Foreground="White"
                                           FontSize="20"/>
                            <materialDesign:PackIcon Kind="Launch"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Margin="10,0,0,0"
                                                 Height="27"
                                                 Width="27"
                                                 Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btn_upload" 
                            Click="btn_upload_Click"
                            Width="auto"
                            Height="60"
                            Margin="0,8,0,0"                     
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            materialDesign:ButtonAssist.CornerRadius="7"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Grid.Row="2" Cursor="">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                            <TextBlock x:Name="text_btn_upload" 
                                       Text='Имеется обновление - "Скачать"'                         
                                       FontFamily="Manrope"
                                       Foreground="White"
                                       FontSize="20"/>
                            <materialDesign:PackIcon Kind="TrayArrowDown"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Margin="10,0,0,0"
                                                 Height="27"
                                                 Width="27"
                                                 Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btn_upload_launch" 
                            Click="btn_upload_launch_Click"
                            Width="auto"
                            Visibility="Collapsed"
                            Height="60"
                            Margin="0,8,0,0"                     
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            materialDesign:ButtonAssist.CornerRadius="7"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Grid.Row="2" Cursor="">

                        <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                            <TextBlock x:Name="text_btn_upload_launch" 
                                       Text='Имеется обновление лаунчера - "Скачать"'                         
                                       FontFamily="Manrope"
                                       Foreground="White"
                                       FontSize="20"/>
                            <materialDesign:PackIcon Kind="TrayArrowDown"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Margin="10,0,0,0"
                                                 Height="27"
                                                 Width="27"
                                                 Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>

    </Border>
</Window>